# Esta pasta separada serve para pegar os dados do bd de forma segura.
# Este arquivo é só um MODELO (pode ir para o Git). Copie-o para um arquivo chamado .env
# e preencha com os seus dados REAIS. O arquivo .env NUNCA deve ir para o Git.
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=coloque_a_senha_do_mysql_aqui
DB_NAME=repairsim2
DB_PORT=3306

# Segredo usado para assinar o token de login. Gere um valor aleatório com:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cole_aqui_o_valor_gerado_com_pelo_menos_32_caracteres

# Endereço do front-end (o Vite usa 5173 por padrão). Mais de um? Separe por vírgula.
FRONTEND_URL=http://localhost:5173

# Em produção troque para production (ativa cookie "secure", que exige HTTPS)
NODE_ENV=development
